<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {# Title, description, canonical, robots, Open Graph, Twitter: shared, themes/_base/partials/seo-meta.njk #}
    {% include "partials/seo-meta.njk" %}

    <meta name="bloob-page-id" content="{{ bloobPageId }}" />
    {% if redirect %}
    <!-- Redirect — set via `redirect:` frontmatter in the content vault -->
    <meta http-equiv="refresh" content="0; url={{ redirect }}" />
    <script>window.location.replace("{{ redirect }}");</script>
    {% endif %}

    <!-- RSS Feed -->
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ "/feed.xml" | url }}" />

    <!-- Favicon (generated at build time from site.logo; see scripts/generate-favicons.js) -->
    <link rel="icon" type="image/png" href="{{ "/favicon.png" | url }}" />
    <link rel="apple-touch-icon" href="{{ "/apple-touch-icon.png" | url }}" />

    <!-- Nunito Sans — marbles-pouch body font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&display=swap"
        rel="stylesheet"
    />
    <!-- Satoshi — used for the bloob.haus footer credit -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
        href="https://api.fontshare.com/v2/css?f[]=satoshi@700&display=optional"
        rel="stylesheet"
    />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="{{ "/assets/css/base.css" | url }}" />
    <link rel="stylesheet" href="{{ "/assets/css/main.css" | url }}" />
    {% include "partials/photoswipe-head.njk" %}
    <!-- Visualizer stylesheets (auto-generated from lib/visualizers/) -->
    <!--bloob:visualizer-css-->
    <!-- Pagefind UI styles — loaded on all pages when search is enabled -->
    {% if site.features.search != false %}
    <link rel="stylesheet" href="{{ "/pagefind/pagefind-ui.css" | url }}" />
    {% endif %}

    {% include "partials/site-snippets-head.njk" %}
</head>
