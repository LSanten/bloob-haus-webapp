{# Raw end-of-body snippets from _bloob-settings.md fences (footer-snippet, embed-endofbody).
   Empty when no fences are present. See docs plan: snippet-injection-analytics.
   Unlisted pages get no third-party code: it would send the page's secret URL to the third
   party (security-by-obscurity.md, Tier C). Applies on every site, no opt-out. #}
{% if site.snippets.bodyEnd and not _bloob_unlisted %}
{{ site.snippets.bodyEnd | injectPageVars(page, title, site.url, bloobPageId) | safe }}
{% endif %}
